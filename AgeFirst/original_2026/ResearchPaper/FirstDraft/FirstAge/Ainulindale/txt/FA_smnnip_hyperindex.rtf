# MODULE 1 — CHARACTER MAP\par
# ==============================================================================\par
\par
class USKeyboardMap:\par
    """\par
    Fixed bijection between US keyboard characters and integer indices 0..96.\par
    Immutable. Built once at import time.\par
    """\par
\par
    _char_to_idx: Dict[str, int] = \{c: i for i, c in enumerate(US_KEYBOARD_CHARS)\}\par
    _idx_to_char: Dict[int, str] = \{i: c for i, c in enumerate(US_KEYBOARD_CHARS)\}\par
\par
    @classmethod\par
    def encode(cls, char: str) -> int:\par
        """Character → index 0..96. Raises KeyError if not in charset."""\par
        if char not in cls._char_to_idx:\par
            raise KeyError(f"Character \{repr(char)\} not in US keyboard charset")\par
        return cls._char_to_idx[char]\par
\par
    @classmethod\par
    def decode(cls, idx: int) -> str:\par
        """Index 0..96 → character."""\par
        if idx not in cls._idx_to_char:\par
            raise KeyError(f"Index \{idx\} out of range 0..96")\par
        return cls._idx_to_char[idx]\par
\par
    @classmethod\par
    def is_valid(cls, char: str) -> bool:\par
        return char in cls._char_to_idx\par
\par
