# ==============================================================================\par
# MODULE 3 — SPHERICAL COLOR COORDINATE SYSTEM\par
# ==============================================================================\par
\par
class SphericalColor:\par
    """\par
    4D spherical color space: (θ, φ, r, ρ)\par
\par
    θ (theta):  hue angle         0 ≤ θ < 2π    position on color wheel\par
    φ (phi):    elevation angle   0 ≤ φ ≤ π     0=white pole, π=black pole\par
    r:          saturation        0 ≤ r ≤ 1     distance from grey axis\par
    ρ (rho):    luminance         0 ≤ ρ ≤ 1     total brightness\par
\par
    Full conversion chain:\par
      (θ, φ, r, ρ) → HSL → RGB → CMYK\par
      CMYK → RGB → HSL → (θ, φ, r, ρ)\par
\par
    Octonion encoding (8 floats = 1 octonion):\par
      [θ_norm, φ_norm, r, ρ, depth, depth_conf, K_derived, reserved]\par
    """\par
\par
    @staticmethod\par
    def rgb_to_spherical(r: float, g: float, b: float) -> Tuple[float,float,float,float]:\par
        """\par
        RGB (each 0..1) → (theta, phi, sat_r, luminance_rho)\par
        """\par
        # Luminance (rho)\par
        rho = 0.2126 * r + 0.7152 * g + 0.0722 * b\par
\par
        # Saturation (r) via HSL\par
        cmax = max(r, g, b)\par
        cmin = min(r, g, b)\par
        delta = cmax - cmin\par
        sat = 0.0 if (cmax + cmin) == 0 else delta / (1.0 - abs(cmax + cmin - 1.0) + 1e-12)\par
        sat = min(1.0, max(0.0, sat))\par
\par
        # Hue angle (theta)\par
        if delta < 1e-9:\par
            theta = 0.0\par
        elif cmax == r:\par
            theta = (math.pi / 3.0) * (((g - b) / (delta + 1e-12)) % 6)\par
        elif cmax == g:\par
            theta = (math.pi / 3.0) * (((b - r) / (delta + 1e-12)) + 2.0)\par
        else:\par
            theta = (math.pi / 3.0) * (((r - g) / (delta + 1e-12)) + 4.0)\par
        theta = theta % (2.0 * math.pi)\par
\par
        # Elevation (phi) — warm colors (red/orange) near 0, cool (blue/violet) near π\par
        # Approximate: phi correlates with B channel dominance\par
        phi = math.pi * (b / (r + g + b + 1e-12))\par
\par
        return theta, phi, sat, rho\par
\par
    @staticmethod\par
    def spherical_to_rgb(theta: float, phi: float,\par
                         sat: float, rho: float) -> Tuple[float,float,float]:\par
        """\par
        (theta, phi, sat, rho) → RGB (each 0..1)\par
        Via HSL intermediate. phi is advisory (warm/cool) — not directly invertible.\par
        """\par
        # Convert to HSL\par
        H_deg = math.degrees(theta) % 360.0\par
        S = min(1.0, max(0.0, sat))\par
        L = min(1.0, max(0.0, rho))\par
\par
        # HSL → RGB (standard formula)\par
        C = (1.0 - abs(2.0 * L - 1.0)) * S\par
        X = C * (1.0 - abs((H_deg / 60.0) % 2.0 - 1.0))\par
        m = L - C / 2.0\par
\par
        sector = int(H_deg / 60.0) % 6\par
        if sector == 0:   r1,g1,b1 = C, X, 0.0\par
        elif sector == 1: r1,g1,b1 = X, C, 0.0\par
        elif sector == 2: r1,g1,b1 = 0.0, C, X\par
        elif sector == 3: r1,g1,b1 = 0.0, X, C\par
        elif sector == 4: r1,g1,b1 = X, 0.0, C\par
        else:             r1,g1,b1 = C, 0.0, X\par
\par
        return (r1 + m, g1 + m, b1 + m)\par
\par
    @staticmethod\par
    def rgb_to_cmyk(r: float, g: float, b: float) -> Tuple[float,float,float,float]:\par
        """RGB (0..1) → CMYK (0..1 each). K derived from absence of RGB."""\par
        k = 1.0 - max(r, g, b)\par
        if abs(k - 1.0) < 1e-9:\par
            return 0.0, 0.0, 0.0, 1.0\par
        inv = 1.0 / (1.0 - k + 1e-12)\par
        c = min(1.0, max(0.0, (1.0 - r - k) * inv))\par
        m = min(1.0, max(0.0, (1.0 - g - k) * inv))\par
        y = min(1.0, max(0.0, (1.0 - b - k) * inv))\par
        return c, m, y, min(1.0, max(0.0, k))\par
\par
    @staticmethod\par
    def cmyk_to_rgb(c: float, m: float,\par
                    y: float, k: float) -> Tuple[float,float,float]:\par
        """CMYK (0..1) → RGB (0..1)."""\par
        r = (1.0 - c) * (1.0 - k)\par
        g = (1.0 - m) * (1.0 - k)\par
        b = (1.0 - y) * (1.0 - k)\par
        return r, g, b\par
\par
    @staticmethod\par
    def to_octonion(r_rgb: float, g_rgb: float, b_rgb: float,\par
                    depth: float = 0.0, depth_conf: float = 0.0) -> List[float]:\par
        """\par
        RGB pixel → 8-component octonion vector for substrate input.\par
        [θ_norm, φ_norm, sat, lum, depth, depth_conf, K_derived, reserved]\par
        """\par
        theta, phi, sat, rho = SphericalColor.rgb_to_spherical(r_rgb, g_rgb, b_rgb)\par
        k = 1.0 - max(r_rgb, g_rgb, b_rgb)\par
        return [\par
            theta / (2.0 * math.pi),   # θ normalized to [0,1]\par
            phi / math.pi,             # φ normalized to [0,1]\par
            sat,                       # saturation\par
            rho,                       # luminance\par
            min(1.0, max(0.0, depth)), # depth estimate (normalized)\par
            min(1.0, max(0.0, depth_conf)),  # depth confidence\par
            min(1.0, max(0.0, k)),     # K derived (absence of RGB)\par
            0.0,                       # reserved\par
        ]\par
\par
    @staticmethod\par
    def color_index(theta: float, phi: float,\par
                    sat: float, rho: float) -> int:\par
        """\par
        Quantize (θ, φ, r, ρ) to a 33-bit integer color index.\par
        idx = θ_q·(PHI·R·RHO) + φ_q·(R·RHO) + r_q·RHO + ρ_q\par
        """\par
        tq = min(THETA_STEPS-1, int(theta / (2.0*math.pi) * THETA_STEPS))\par
        pq = min(PHI_STEPS-1,   int(phi / math.pi * PHI_STEPS))\par
        rq = min(R_STEPS-1,     int(sat * R_STEPS))\par
        lq = min(RHO_STEPS-1,   int(rho * RHO_STEPS))\par
        return (tq * PHI_STEPS * R_STEPS * RHO_STEPS +\par
                pq * R_STEPS * RHO_STEPS +\par
                rq * RHO_STEPS + lq)\par
\par
\par
# ==============================================================================\par
# MODULE 4 — GENERALIZED MULTI-CHANNEL TUPPER\par
# ==============================================================================\par
\par
class MultiChannelTupper:\par
    """\par
    Generalized Tupper's Self-Referential Formula for multi-channel float images.\par
\par
    Standard Tupper (binary, H=17):\par
      pixel(x,y) = ½ < ⌊ mod(⌊y/H⌋ · 2^(−H·x − y mod H), 2) ⌋\par
\par
    Generalized (b-bit depth, H=8 for octonion alignment):\par
      pixel_c(x,y) = ⌊ mod(⌊k_c / B^(H·x + y mod H)⌋, B) ⌋ / (B-1)\par
      where B = 2^b\par
\par
    H=8: each column of the Tupper bitmap encodes one full octonion.\par
    8 octants of the color sphere × 8 elevation bands = one tile.\par
\par
    Encode: k_c = Σ_\{x=0\}^\{W-1\} Σ_\{y=0\}^\{H-1\} quantize(v, b) · B^(H·x + y)\par
    Decode: value = ⌊ mod(⌊k_c / B^(H·x + y)⌋, B) ⌋ / (B-1)\par
\par
    Storage per 8×8 tile at b=8:\par
      k per channel = 512 bits = 64 bytes\par
      4 CMYK channels = 2048 bits = 256 bytes\par
      Stored as Python int (arbitrary precision)\par
      Ledger stores as decimal string\par
    """\par
\par
    H: int = TUPPER_H\par
    B: int = 2 ** TUPPER_BITS   # = 256\par
\par
    @classmethod\par
    def encode_channel(cls, channel_values: List[List[float]]) -> int:\par
        """\par
        Encode a 2D float array (W × H, values 0..1) into k for one channel.\par
        channel_values[x][y] ∈ [0, 1]\par
        Returns k as Python int (arbitrary precision).\par
        """\par
        W = len(channel_values)\par
        H = cls.H\par
        B = cls.B\par
        k = 0\par
        for x in range(W):\par
            col = channel_values[x]\par
            for y in range(min(H, len(col))):\par
                q = min(B - 1, int(col[y] * B))\par
                k += q * (B ** (H * x + y))\par
        return k\par
\par
    @classmethod\par
    def decode_channel(cls, k: int, W: int) -> List[List[float]]:\par
        """\par
        Decode k back to W × H float array.\par
        Returns channel_values[x][y] ∈ [0, 1].\par
        """\par
        H = cls.H\par
        B = cls.B\par
        result = []\par
        k_work = k\par
        for x in range(W):\par
            col = []\par
            for y in range(H):\par
                pos = H * x + y\par
                val_q = (k_work // (B ** pos)) % B\par
                col.append(val_q / (B - 1))\par
            result.append(col)\par
        return result\par
\par
    @classmethod\par
    def encode_tile(cls, tile_cmyk: List[List[List[float]]]) -> Tuple[int,int,int,int]:\par
        """\par
        Encode an 8×8 CMYK tile into 4 k values.\par
        tile_cmyk[channel][x][y] — channel: 0=C, 1=M, 2=Y, 3=K\par
\par
        Returns (k_C, k_M, k_Y, k_K) as Python ints.\par
        """\par
        return tuple(\par
            cls.encode_channel(tile_cmyk[c])\par
            for c in range(CMYK_CHANNELS)\par
        )\par
\par
    @classmethod\par
    def decode_tile(cls, k_vec: Tuple[int,int,int,int],\par
                    W: int = 8) -> List[List[List[float]]]:\par
        """\par
        Decode (k_C, k_M, k_Y, k_K) back to tile_cmyk[channel][x][y].\par
        """\par
        return [cls.decode_channel(k_vec[c], W) for c in range(CMYK_CHANNELS)]\par
\par
    @classmethod\par
    def tile_index_record(cls,\par
                          tile_cmyk: List[List[List[float]]],\par
                          tile_x: int = 0,\par
                          tile_y: int = 0) -> Dict[str, Any]:\par
        """\par
        Full INDEX_RECORD for one image tile.\par
        Returns dict with k_C, k_M, k_Y, k_K as strings (arbitrary precision safe).\par
        """\par
        k_C, k_M, k_Y, k_K = cls.encode_tile(tile_cmyk)\par
        return \{\par
            'k_C':    str(k_C),\par
            'k_M':    str(k_M),\par
            'k_Y':    str(k_Y),\par
            'k_K':    str(k_K),\par
            'tile_x': tile_x,\par
            'tile_y': tile_y,\par
            'H':      cls.H,\par
            'b':      TUPPER_BITS,\par
        \}\par
\par
