\par
class TextHyperIndex:\par
    """\par
    Lossless permutation index for text sequences.\par
\par
    Two indices computed simultaneously:\par
      text_index  : base-97 mixed-radix integer (exact sequence address)\par
      fano_index  : base-7 Fano/octonion path (algebra-native address)\par
\par
    Both are pure Python int — arbitrary precision, no overflow.\par
    TensorFlow callers receive these as strings from the ledger.\par
\par
    Stored as INDEX_RECORD = (text_index: int, fano_index: int, data_length: int)\par
    """\par
\par
    @staticmethod\par
    def encode_text(sequence: str) -> int:\par
        """\par
        Encode a character sequence as a base-97 integer.\par
        idx = c0·97^(k-1) + c1·97^(k-2) + ... + c_\{k-1\}·97^0\par
\par
        Lossless. Invertible. Any length.\par
        """\par
        idx = 0\par
        for char in sequence:\par
            idx = idx * VOCAB_BASE + USKeyboardMap.encode(char)\par
        return idx\par
\par
    @staticmethod\par
    def decode_text(idx: int, length: int) -> str:\par
        """\par
        Decode base-97 integer back to character sequence of given length.\par
        """\par
        chars = []\par
        remaining = idx\par
        for _ in range(length):\par
            chars.append(USKeyboardMap.decode(remaining % VOCAB_BASE))\par
            remaining //= VOCAB_BASE\par
        chars.reverse()\par
        return ''.join(chars)\par
\par
    @staticmethod\par
    def encode_fano(sequence: str) -> int:\par
        """\par
        Encode a character sequence as a Fano/octonion base-7 path index.\par
\par
        Each character maps to an octonion generator via:\par
          fano_component = char_index % FANO_BASE  (0..6 → e1..e7)\par
\par
        This is the algebra-native address of the sequence.\par
        Different from the text index — encodes which octonion\par
        generators were traversed, not which characters.\par
        """\par
        idx = 0\par
        for char in sequence:\par
            component = USKeyboardMap.encode(char) % FANO_BASE\par
            idx = idx * FANO_BASE + component\par
        return idx\par
\par
    @staticmethod\par
    def decode_fano(idx: int, length: int) -> List[int]:\par
        """\par
        Decode Fano index back to sequence of generator indices (0..6).\par
        """\par
        components = []\par
        remaining = idx\par
        for _ in range(length):\par
            components.append(remaining % FANO_BASE)\par
            remaining //= FANO_BASE\par
        components.reverse()\par
        return components\par
\par
    @staticmethod\par
    def index_record(sequence: str) -> Tuple[int, int, int]:\par
        """\par
        Compute full INDEX_RECORD for a text sequence.\par
        Returns (text_index, fano_index, data_length).\par
        """\par
        return (\par
            TextHyperIndex.encode_text(sequence),\par
            TextHyperIndex.encode_fano(sequence),\par
            len(sequence)\par
        )\par
\par
    @staticmethod\par
    def verify(sequence: str) -> bool:\par
        """\par
        Round-trip verification: encode then decode returns original.\par
        """\par
        text_idx, _, length = TextHyperIndex.index_record(sequence)\par
        recovered = TextHyperIndex.decode_text(text_idx, length)\par
        return recovered == sequence\par
\par
