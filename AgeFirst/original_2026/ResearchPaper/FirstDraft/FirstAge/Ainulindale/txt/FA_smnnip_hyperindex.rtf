# MODULE 5 — IMAGE HYPERINDEX\par
# ==============================================================================\par
\par
class ImageHyperIndex:\par
    """\par
    Lossless hyperindex for image tiles.\par
\par
    Pipeline:\par
      RGB pixel → spherical (θ,φ,r,ρ) → CMYK → Tupper k-vector\par
      Tupper k-vector → tile INDEX_RECORD\par
\par
    Radial correspondence for image tiles:\par
      r(tile) = 1.0 - sqrt((tx - cx)^2 + (ty - cy)^2) / r_max\par
      Image center is the Observer at r=0 (destination-centric).\par
      Tiles further from center are at larger r (closer to input surface).\par
    """\par
\par
    @staticmethod\par
    def rgb_tile_to_cmyk(rgb_tile: List[List[Tuple[float,float,float]]]\par
                         ) -> List[List[List[float]]]:\par
        """\par
        Convert W×H RGB tile to CMYK tile.\par
        rgb_tile[x][y] = (r, g, b) each 0..1\par
        Returns cmyk_tile[channel][x][y]\par
        """\par
        W = len(rgb_tile)\par
        H = len(rgb_tile[0]) if W > 0 else 0\par
        cmyk = [[[] for _ in range(W)] for _ in range(CMYK_CHANNELS)]\par
        for x in range(W):\par
            for y in range(H):\par
                r, g, b = rgb_tile[x][y]\par
                k = 1.0 - max(r, g, b)\par
                if abs(k - 1.0) < 1e-9:\par
                    c, m, yv = 0.0, 0.0, 0.0\par
                else:\par
                    inv = 1.0 / (1.0 - k + 1e-12)\par
                    c  = min(1.0, max(0.0, (1.0 - r - k) * inv))\par
                    m  = min(1.0, max(0.0, (1.0 - g - k) * inv))\par
                    yv = min(1.0, max(0.0, (1.0 - b - k) * inv))\par
                cmyk[0][x].append(c)\par
                cmyk[1][x].append(m)\par
                cmyk[2][x].append(yv)\par
                cmyk[3][x].append(k)\par
        return cmyk\par
\par
    @staticmethod\par
    def tile_radial_r(tile_x: int, tile_y: int,\par
                      img_w_tiles: int, img_h_tiles: int) -> float:\par
        """\par
        Map tile position to radial coordinate r.\par
        Image center = Observer at r→0 (destination).\par
        Input edge tiles at r=1.\par
\par
        r(tile) = sqrt((tx - cx)^2 + (ty - cy)^2) / r_max\par
        (inverted so center=0, edge=1)\par
        """\par
        cx = (img_w_tiles - 1) / 2.0\par
        cy = (img_h_tiles - 1) / 2.0\par
        r_max = math.sqrt(cx**2 + cy**2) + 1e-12\par
        dist = math.sqrt((tile_x - cx)**2 + (tile_y - cy)**2)\par
        return min(1.0, dist / r_max)\par
\par
    @staticmethod\par
    def index_record(rgb_tile: List[List[Tuple[float,float,float]]],\par
                     tile_x: int = 0, tile_y: int = 0,\par
                     img_w_tiles: int = 1, img_h_tiles: int = 1,\par
                     depth_est: float = 0.0,\par
                     depth_conf: float = 0.0) -> Dict[str, Any]:\par
        """\par
        Full INDEX_RECORD for one image tile.\par
        """\par
        cmyk = ImageHyperIndex.rgb_tile_to_cmyk(rgb_tile)\par
        tupper = MultiChannelTupper.tile_index_record(cmyk, tile_x, tile_y)\par
        r = ImageHyperIndex.tile_radial_r(tile_x, tile_y, img_w_tiles, img_h_tiles)\par
\par
        # Representative pixel color index (center pixel)\par
        cx = len(rgb_tile) // 2\par
        cy = len(rgb_tile[0]) // 2 if len(rgb_tile) > 0 else 0\par
        try:\par
            rc, gc, bc = rgb_tile[cx][cy]\par
            theta, phi, sat, rho = SphericalColor.rgb_to_spherical(rc, gc, bc)\par
            color_idx = SphericalColor.color_index(theta, phi, sat, rho)\par
        except (IndexError, ValueError):\par
            color_idx = 0\par
\par
        return \{\par
            **tupper,\par
            'color_index': str(color_idx),\par
            'radial_r':    r,\par
            'depth_est':   depth_est,\par
            'depth_conf':  depth_conf,\par
        \}\par
\par
\par
# ==============================================================================\par
# MODULE 6 — HIERARCHICAL CODE INDEX\par
# ==============================================================================\par
\par
class CodeIndex:\par
    """\par
    Hierarchical address scheme for the codebase.\par
\par
    Level 0 — Global  (ℝ, trivial): SHA256 of entire file\par
    Level 1 — Class   (ℂ, U(1)):    G·7 + class_k\par
    Level 2 — Method  (ℍ, SU(2)):   G·7² + class_k·7 + method_m\par
    Level 3 — Line    (𝕆, G₂):     G·7³ + class_k·7² + method_m·7 + line_n\par
\par
    Each address encodes its full ancestry.\par
    Strip indices from right to walk back to root.\par
    Non-commutativity at ℍ: (class, method) order matters.\par
    Non-associativity at 𝕆: nesting structure baked into address.\par
    """\par
\par
    @staticmethod\par
    def global_hash(filepath: str) -> str:\par
        """SHA256 of file contents."""\par
        with open(filepath, 'rb') as f:\par
            return hashlib.sha256(f.read()).hexdigest()\par
\par
    @staticmethod\par
    def build(filepath: str) -> Dict[str, Any]:\par
        """\par
        Build the CODE_INDEX for a Python source file.\par
        Scans for class and def statements.\par
        """\par
        if not os.path.exists(filepath):\par
            return \{\}\par
\par
        g_hash = CodeIndex.global_hash(filepath)\par
        g_int  = int(g_hash, 16) % (7**6)  # compact global index\par
\par
        classes  = \{\}\par
        methods  = \{\}\par
        current_class = None\par
        current_method = None\par
        class_k  = 0\par
        method_m = 0\par
\par
        with open(filepath, 'r', encoding='utf-8') as f:\par
            lines = f.readlines()\par
\par
        for line_n, line in enumerate(lines):\par
            stripped = line.lstrip()\par
            if stripped.startswith('class '):\par
                name = stripped[6:].split('(')[0].split(':')[0].strip()\par
                addr = g_int * 7 + class_k\par
                classes[name] = \{\par
                    'class_idx': class_k,\par
                    'address':   addr,\par
                    'line_start': line_n,\par
                \}\par
                current_class = name\par
                class_k += 1\par
                method_m = 0\par
\par
            elif stripped.startswith('def '):\par
                name = stripped[4:].split('(')[0].strip()\par
                ck   = classes[current_class]['class_idx'] if current_class else 0\par
                addr = g_int * 49 + ck * 7 + method_m\par
                key  = f"\{current_class\}.\{name\}" if current_class else name\par
                methods[key] = \{\par
                    'class':      current_class,\par
                    'method_idx': method_m,\par
                    'address':    addr,\par
                    'line_start': line_n,\par
                \}\par
                current_method = key\par
                method_m += 1\par
\par
        return \{\par
            'filepath':    filepath,\par
            'global_hash': g_hash,\par
            'global_idx':  g_int,\par
            'total_lines': len(lines),\par
            'total_bytes': os.path.getsize(filepath),\par
            'classes':     classes,\par
            'methods':     methods,\par
            'version':     'FA_1.0',\par
            'charset':     'US_KB_97',\par
            'algebra_tower': 'R->C->H->O',\par
            'sedenion_boundary': SEDENION_BOUNDARY,\par
        \}\par
\par
\par
# ==============================================================================\par
# MODULE 7 — BLOCKCHAIN LEDGER\par
# ==============================================================================\par
\par
class BlockchainLedger:\par
    """\par
    Append-only blockchain ledger for training history.\par
\par
    Each block:\par
      block_id       : int\par
      timestamp      : ISO datetime string\par
      prev_hash      : SHA256 of previous block (genesis = '0'*64)\par
      modality       : 'text' | 'image'\par
      epoch          : int\par
      step           : int\par
      perm_index     : str  (arbitrary precision decimal, text or Tupper k)\par
      data_length    : int  (context window k or tile count)\par
      layer          : str  ('R'|'C'|'H'|'O')\par
      noether_current: float\par
      mastered       : bool  (crystallization event)\par
      block_hash     : SHA256 of this block's content\par
\par
    Two output files:\par
      .jsonl  — human readable, one JSON per line\par
      .chain  — verification file (hashes only, fast check)\par
\par
    Tamper detection: any modification breaks subsequent hashes.\par
    Provenance: every crystallized weight traces back to its training data.\par
    """\par
\par
    def __init__(self, base_path: str = 'FA_hyperindex_ledger'):\par
        self.jsonl_path  = base_path + '.jsonl'\par
        self.chain_path  = base_path + '.chain'\par
        self._prev_hash  = '0' * 64\par
        self._block_id   = 0\par
        self._load_state()\par
\par
    def _load_state(self) -> None:\par
        """Resume from existing ledger if present."""\par
        if os.path.exists(self.jsonl_path):\par
            try:\par
                with open(self.jsonl_path, 'r') as f:\par
                    lines = [l.strip() for l in f if l.strip()]\par
                if lines:\par
                    last = json.loads(lines[-1])\par
                    self._prev_hash = last.get('block_hash', '0'*64)\par
                    self._block_id  = last.get('block_id', -1) + 1\par
            except (json.JSONDecodeError, KeyError):\par
                pass\par
\par
    def _make_hash(self, block: Dict[str, Any]) -> str:\par
        content = (\par
            f"\{block['block_id']\}|\{block['timestamp']\}|\{block['prev_hash']\}|"\par
            f"\{block['modality']\}|\{block['epoch']\}|\{block['step']\}|"\par
            f"\{block['perm_index']\}|\{block['data_length']\}|\{block['layer']\}|"\par
            f"\{block['noether_current']:.8f\}|\{block['mastered']\}"\par
        )\par
        return hashlib.sha256(content.encode()).hexdigest()\par
\par
    def append(self,\par
               modality: str,\par
               epoch: int,\par
               step: int,\par
               perm_index: Any,     # int or str\par
               data_length: int,\par
               layer: str,\par
               noether_current: float,\par
               mastered: bool = False,\par
               extra: Optional[Dict] = None) -> Dict[str, Any]:\par
        """\par
        Append one block to the ledger.\par
        Returns the completed block dict.\par
        """\par
        now = datetime.datetime.now(datetime.timezone.utc)\par
        ts  = now.isoformat()\par
\par
        block: Dict[str, Any] = \{\par
            'block_id':        self._block_id,\par
            'timestamp':       ts,\par
            'prev_hash':       self._prev_hash,\par
            'modality':        modality,\par
            'epoch':           epoch,\par
            'step':            step,\par
            'perm_index':      str(perm_index),\par
            'data_length':     data_length,\par
            'layer':           layer,\par
            'noether_current': float(noether_current),\par
            'mastered':        mastered,\par
        \}\par
        if extra:\par
            block['extra'] = extra\par
\par
        block['block_hash'] = self._make_hash(block)\par
\par
        # Write to jsonl\par
        with open(self.jsonl_path, 'a') as f:\par
            f.write(json.dumps(block) + '\\n')\par
\par
        # Write to chain (hashes only)\par
        with open(self.chain_path, 'a') as f:\par
            f.write(f"\{block['block_id']\}:\{block['block_hash']\}\\n")\par
\par
        self._prev_hash = block['block_hash']\par
        self._block_id += 1\par
        return block\par
\par
    def verify(self) -> Tuple[bool, int, str]:\par
        """\par
        Verify the entire chain.\par
        Returns (valid, first_broken_id, message).\par
        """\par
        if not os.path.exists(self.jsonl_path):\par
            return True, -1, "No ledger found"\par
\par
        prev = '0' * 64\par
        with open(self.jsonl_path, 'r') as f:\par
            for line in f:\par
                line = line.strip()\par
                if not line:\par
                    continue\par
                try:\par
                    block = json.loads(line)\par
                except json.JSONDecodeError:\par
                    return False, -1, "JSON decode error"\par
\par
                if block.get('prev_hash') != prev:\par
                    return False, block['block_id'], \\\par
                           f"Chain broken at block \{block['block_id']\}: prev_hash mismatch"\par
\par
                stored_hash = block.pop('block_hash', None)\par
                computed    = self._make_hash(block)\par
                block['block_hash'] = stored_hash\par
\par
                if stored_hash != computed:\par
                    return False, block['block_id'], \\\par
                           f"Chain broken at block \{block['block_id']\}: hash mismatch"\par
\par
                prev = stored_hash\par
\par
        return True, -1, f"Chain valid — \{self._block_id\} blocks verified"\par
\par
    def last_hash(self) -> str:\par
        return self._prev_hash\par
\par
\par
# ==============================================================================\par
# MODULE 8 — SEDENION BOUNDARY GUARD\par
# ==============================================================================\par
\par
class SedenionBoundaryViolation(Exception):\par
    """\par
    Raised when code attempts to operate beyond the 𝕆 layer.\par
\par
    The NN tower terminates at 𝕆.\par
    𝕊 (sedenion) informs the Lagrangian from outside but does not run inside.\par
    Zero-divisors in 𝕊 break norm preservation — the training invariant.\par
    Mastery transition (𝕆→𝕊) is crystallization, not computation.\par
    """\par
    pass\par
\par
\par
def assert_within_tower(algebra_index: int) -> None:\par
    """\par
    Assert that an algebra index is within the NN tower (≤ 𝕆).\par
    Raises SedenionBoundaryViolation if algebra_index >= SEDENION_BOUNDARY.\par
    """\par
    if algebra_index >= SEDENION_BOUNDARY:\par
        raise SedenionBoundaryViolation(\par
            f"Algebra index \{algebra_index\} exceeds 𝕆 (index 3). "\par
            f"The NN tower terminates at 𝕆. "\par
            f"Sedenion (index 4+) is outside the training domain. "\par
            f"Mastery transition occurs via crystallize(), not forward()."\par
        )\par
\par
\par
# ==============================================================================\par
# MODULE 9 — RADIAL / LAYER CORRESPONDENCE\par
# ==============================================================================\par
\par
def layer_to_r(layer: int, L_total: int = 4) -> float:\par
    """\par
    Map layer depth index to radial coordinate r.\par
\par
    ℝ substrate (layer=0) is at the outermost surface: r = 1.0\par
    𝕆 reasoning (layer=3) is innermost, closest to Observer: r = 0.25\par
    Observer itself (r→0) is outside the NN.\par
\par
    r(l) = (L_total - l) / L_total\par
\par
    Ainulindale polar form: α_NN(r) = g² / (4π·ħ_NN·ln(1/r))\par
    RG form equivalent:     α_NN(l) = α_0 / (1 + β_0·α_0·ln(l/l_0))\par
    Bridge:                 ln(1/r) = ln(L/(L-l))\par
    """\par
    assert_within_tower(layer)\par
    return max(1e-6, (L_total - layer) / L_total)\par
\par
\par
def r_to_layer(r: float, L_total: int = 4) -> int:\par
    """\par
    Map radial coordinate r back to layer depth index.\par
    Inverse of layer_to_r.\par
    """\par
    return max(0, min(L_total - 1, round(L_total * (1.0 - r))))\par
\par
\par
def alpha_nn_from_r(g: float, hbar: float, r: float) -> float:\par
    """\par
    Neural fine structure constant from radial coordinate.\par
    α_NN(r) = g² / (4π·ħ_NN·ln(1/r))\par
\par
    Ainulindale form — singular at r→0 by design (full coupling at destination).\par
    r_min = 1/L_total prevents singularity in practice.\par
    """\par
    if r <= 0:\par
        return float('inf')\par
    ln_inv_r = math.log(1.0 / r)\par
    if ln_inv_r < 1e-12:\par
        return 0.0\par
    return (g**2) / (4.0 * math.pi * hbar * ln_inv_r)\par
\par
\par
# ==============================================================================\par
# MODULE 10 — POLAR LAGRANGIAN WRAPPER\par
# ==============================================================================\par
\par
def polar_lagrangian(L_kin: float, L_mat: float,\par
                     L_bias: float, L_coup: float,\par
                     layer: int = 0, L_total: int = 4) -> float:\par
    """\par
    Ainulindale corrected Lagrangian density.\par
\par
    ℒ_NN = (2/π) ∮ [ℒ_kin + ℒ_mat + (1/φ)·ℒ_bias + ℒ_coup] dr dθ\par
\par
    Discrete approximation (one layer = one integration step):\par
      ℒ_NN(l) ≈ (2/π) · Δr · [ℒ_kin + ℒ_mat + (1/φ)·ℒ_bias + ℒ_coup]\par
\par
    Where:\par
      (2/π)  : radian normalization of circular polar measure\par
      (1/φ)  : golden ratio conjugate bias coupling = 0.6180...\par
               (from Ainulindale_Conjecture_Revised.docx, April 13 2026)\par
      Δr     : radial step = 1/L_total (uniform layer spacing)\par
\par
    The bias term carries (1/φ) because in destination-centric coordinates\par
    the bias field must be weighted by the golden ratio conjugate to preserve\par
    the VEV relationship under the conformal map from Cartesian to polar.\par
    """\par
    PHI  = (1.0 + math.sqrt(5.0)) / 2.0\par
    bias_coupling = 1.0 / PHI          # = 0.61803...\par
    two_over_pi   = 2.0 / math.pi      # = 0.63662...\par
    delta_r       = 1.0 / L_total\par
\par
    inner = L_kin + L_mat + bias_coupling * L_bias + L_coup\par
    return two_over_pi * delta_r * inner\par
\par
