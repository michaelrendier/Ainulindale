# SELF-TEST\par
# ==============================================================================\par
\par
def run_self_test() -> bool:\par
    """Quick verification of all modules."""\par
    print("FA_smnnip_hyperindex — self-test")\par
    print("=" * 50)\par
    passed = 0\par
    failed = 0\par
\par
    # Test 1: US keyboard map\par
    try:\par
        assert USKeyboardMap.encode('a') == 0\par
        assert USKeyboardMap.decode(0) == 'a'\par
        assert USKeyboardMap.encode(' ') == 94   # space is at index 94\par
        assert USKeyboardMap.encode('\\n') == 96  # newline at 96\par
        assert len(US_KEYBOARD_CHARS) == 97\par
        print("  [PASS] USKeyboardMap: charset verified (97 chars)")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] USKeyboardMap: \{e\}")\par
        failed += 1\par
\par
    # Test 2: Text hyperindex round-trip\par
    try:\par
        seq = "Hello!"\par
        idx, fidx, length = TextHyperIndex.index_record(seq)\par
        recovered = TextHyperIndex.decode_text(idx, length)\par
        assert recovered == seq, f"Got \{repr(recovered)\}"\par
        assert TextHyperIndex.verify(seq)\par
        print(f"  [PASS] TextHyperIndex: '\{seq\}' -> idx=\{idx\} -> '\{recovered\}'")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] TextHyperIndex: \{e\}")\par
        failed += 1\par
\par
    # Test 3: Long sequence (overflow test, ASCII only)\par
    try:\par
        seq = "The Two Towers Ainulindale First Age 2026"\par
        idx, fidx, length = TextHyperIndex.index_record(seq)\par
        recovered = TextHyperIndex.decode_text(idx, length)\par
        assert recovered == seq\par
        print(f"  [PASS] TextHyperIndex long: \{length\} chars, \{idx.bit_length()\} bits")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] TextHyperIndex long: \{e\}")\par
        failed += 1\par
\par
    # Test 4: Spherical color (phi is lossy by design — test invertible dims only)\par
    try:\par
        r, g, b = 0.8, 0.3, 0.1\par
        theta, phi, sat, rho = SphericalColor.rgb_to_spherical(r, g, b)\par
        # phi encodes warm/cool from B channel — not fully invertible\par
        # Test that theta, sat, rho reconstruct reasonably\par
        r2, g2, b2 = SphericalColor.spherical_to_rgb(theta, phi, sat, rho)\par
        # Luminance and saturation should be close; hue should be close\par
        rho2 = 0.2126*r2 + 0.7152*g2 + 0.0722*b2\par
        rho1 = 0.2126*r  + 0.7152*g  + 0.0722*b\par
        err_lum = abs(rho1 - rho2)\par
        assert err_lum < 0.12, f"Luminance error \{err_lum:.4f\} too large"\par
        print(f"  [PASS] SphericalColor: theta=\{theta:.3f\} sat=\{sat:.3f\} "\par
              f"rho=\{rho:.3f\} lum_err=\{err_lum:.4f\} (phi is advisory/lossy)")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] SphericalColor: \{e\}")\par
        failed += 1\par
\par
    # Test 5: Tupper encode/decode round-trip\par
    try:\par
        tile = [[[0.5 + 0.1*x*0.1*y for y in range(8)]\par
                  for x in range(8)]\par
                 for _ in range(4)]\par
        k_vec = MultiChannelTupper.encode_tile(tile)\par
        recovered = MultiChannelTupper.decode_tile(k_vec)\par
        err = max(abs(tile[c][x][y] - recovered[c][x][y])\par
                  for c in range(4) for x in range(8) for y in range(8))\par
        assert err < 1.0/(2**TUPPER_BITS), f"Quantization error \{err:.6f\}"\par
        total_bits = sum(k.bit_length() for k in k_vec)\par
        print(f"  [PASS] MultiChannelTupper: 4ch 8×8 tile, total bits=\{total_bits\}, err=\{err:.6f\}")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] MultiChannelTupper: \{e\}")\par
        failed += 1\par
\par
    # Test 6: Radial correspondence\par
    try:\par
        for l in range(4):\par
            r = layer_to_r(l, 4)\par
            l2 = r_to_layer(r, 4)\par
            assert l2 == l, f"layer \{l\} → r=\{r:.3f\} → layer \{l2\}"\par
        print(f"  [PASS] Radial correspondence: ℝ(r=1.0)→ℂ(0.75)→ℍ(0.50)→𝕆(0.25)")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] Radial correspondence: \{e\}")\par
        failed += 1\par
\par
    # Test 7: Sedenion boundary\par
    try:\par
        assert_within_tower(3)   # 𝕆 — OK\par
        try:\par
            assert_within_tower(4)  # 𝕊 — should raise\par
            print("  [FAIL] Sedenion boundary: should have raised")\par
            failed += 1\par
        except SedenionBoundaryViolation:\par
            print("  [PASS] Sedenion boundary: 𝕆 passes, 𝕊 raises")\par
            passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] Sedenion boundary: \{e\}")\par
        failed += 1\par
\par
    # Test 8: Polar Lagrangian\par
    try:\par
        L = polar_lagrangian(L_kin=-0.5, L_mat=0.3, L_bias=0.1, L_coup=-0.2, layer=0)\par
        assert L != 0.0\par
        PHI = (1 + math.sqrt(5)) / 2\par
        expected_inner = -0.5 + 0.3 + (1/PHI)*0.1 + (-0.2)\par
        expected = (2/math.pi) * 0.25 * expected_inner\par
        assert abs(L - expected) < 1e-10, f"Got \{L\}, expected \{expected\}"\par
        print(f"  [PASS] Polar Lagrangian: (2/π)∮[...+(1/φ)L_bias+...] = \{L:.6f\}")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] Polar Lagrangian: \{e\}")\par
        failed += 1\par
\par
    # Test 9: Blockchain ledger\par
    try:\par
        import tempfile\par
        with tempfile.TemporaryDirectory() as tmpdir:\par
            ledger = BlockchainLedger(os.path.join(tmpdir, 'test_ledger'))\par
            b0 = ledger.append('text',  0, 0, 12345,   8, 'R', 0.001, False)\par
            b1 = ledger.append('image', 0, 1, 99999,  64, 'O', 0.003, True)\par
            valid, broken_id, msg = ledger.verify()\par
            assert valid, f"Chain invalid: \{msg\}"\par
            assert b1['prev_hash'] == b0['block_hash']\par
        print(f"  [PASS] Blockchain ledger: 2-block chain verified, mastery event recorded")\par
        passed += 1\par
    except Exception as e:\par
        print(f"  [FAIL] Blockchain ledger: \{e\}")\par
        failed += 1\par
\par
    print("=" * 50)\par
    print(f"  Results: \{passed\} passed, \{failed\} failed")\par
    return failed == 0\par
\par
\par
if __name__ == '__main__':\par
    ok = run_self_test()\par
    raise SystemExit(0 if ok else 1)\par

