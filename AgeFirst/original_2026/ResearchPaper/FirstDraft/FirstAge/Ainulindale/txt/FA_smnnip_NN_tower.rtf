\par
class ImageSubstrate:\par
    """Layer 0: 8x8 RGB tile -> spherical CMYK Oct -> hidden_dim."""\par
\par
    def __init__(self, hidden_dim, tile=8, img_w=8, img_h=8):\par
        self.tile    = tile\par
        self.in_dim  = tile * tile * 8\par
        self.hidden_dim = hidden_dim\par
        self.img_w   = img_w\par
        self.img_h   = img_h\par
\par
        self.W = MasteredWeightField(self.in_dim, hidden_dim, 0)\par
        self.B = MasteredBiasField(hidden_dim, 0, LMU[0], LLAM[0])\par
\par
    def encode(self, rgb_tile, depth=0.0, conf=0.0):\par
        flat = []\par
        for x in range(self.tile):\par
            for y in range(self.tile):\par
                try:   rv,gv,bv = rgb_tile[x][y]\par
                except: rv,gv,bv = 0.0,0.0,0.0\par
                flat.extend(SphericalColor.to_octonion(rv,gv,bv,depth,conf))\par
        while len(flat) < self.in_dim: flat.append(0.0)\par
        return flat[:self.in_dim]\par
\par
    def forward(self, rgb_tile, depth=0.0, conf=0.0):\par
        psi = self.encode(rgb_tile, depth, conf)\par
        out = self.W.forward(psi)\par
        out = self.B.apply(out)\par
        out = _relu(out)\par
        L_kin = -0.25 * self.W.field_strength()**2\par
        J     = self.W.noether(psi)\par
        return out, L_kin, J\par
\par
    def backward(self, rgb_tile, grad, lr, depth=0.0, conf=0.0):\par
        psi = self.encode(rgb_tile, depth, conf)\par
        gi  = self.W.update(psi, grad, lr)\par
        self.B.update(grad, lr)\par
        wm = self.W.check_mastery(self.B.vev)\par
        bm = self.B.check_mastery()\par
        return gi, wm, bm\par
\par
    def tile_r(self, tx, ty):\par
        return ImageHyperIndex.tile_radial_r(tx, ty, self.img_w, self.img_h)\par
\par
    def hyperindex(self, rgb_tile, tx=0, ty=0, depth=0.0, conf=0.0):\par
        return ImageHyperIndex.index_record(\par
            rgb_tile, tx, ty, self.img_w, self.img_h, depth, conf)\par
\par
