# ==============================================================================\par
# MASTERED BIAS FIELD\par
# ==============================================================================\par
\par
class MasteredBiasField:\par
    """Higgs bias field with (1/phi) polar correction and mastery."""\par
\par
    def __init__(self, size, layer, mu_sq, lam):\par
        self.size  = size\par
        self.layer = layer\par
        self.mu_sq = mu_sq\par
        self.lam   = lam\par
        self.vev   = math.sqrt(mu_sq/(2.0*lam)) if mu_sq > 0 else 0.0\par
        self._mastered  = False\par
        self._threshold = MASTERY_THRESHOLDS[LNAME[layer]]\par
        self.beta = [random.gauss(0.0, 0.01) for _ in range(size)]\par
        self.vel  = _zeros(size)\par
\par
    def is_mastered(self):  return self._mastered\par
    def apply(self, psi):\par
        return [psi[i] + self.beta[i] for i in range(min(len(psi), self.size))]\par
\par
    def potential(self):\par
        b2 = sum(b*b for b in self.beta)\par
        return -self.mu_sq*b2 + self.lam*b2*b2\par
\par
    def polar_l_bias(self):\par
        """L_bias with (1/phi) Ainulindale correction."""\par
        return BIAS_COUP * self.potential()\par
\par
    def vev_dist(self):\par
        return abs(math.sqrt(sum(b*b for b in self.beta)) - self.vev)\par
\par
    def update(self, overlap, lr, mom=0.9):\par
        if self._mastered: return\par
        b2 = sum(b*b for b in self.beta)\par
        for i in range(self.size):\par
            dV    = (-2.0*self.mu_sq + 4.0*self.lam*b2) * self.beta[i]\par
            drive = -overlap[i] if i < len(overlap) else 0.0\par
            self.vel[i]  = mom*self.vel[i] - lr*(dV+drive)\par
            self.beta[i] = _clip(self.beta[i] + self.vel[i])\par
\par
    def check_mastery(self):\par
        if self._mastered: return True\par
        if self.vev_dist() < self._threshold:\par
            self._mastered = True\par
            self.vel = _zeros(self.size)\par
        return self._mastered\par
