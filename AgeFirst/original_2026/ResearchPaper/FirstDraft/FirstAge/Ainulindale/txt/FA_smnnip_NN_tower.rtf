\par
class FAImageNNTower:\par
    """ImageSubstrate -> SharedUpperTower -> class output."""\par
\par
    def __init__(self, hidden_dim=64, n_classes=16, tile=8,\par
                 img_w=8, img_h=8,\par
                 ledger_path='FA_hyperindex_ledger'):\par
        self.hidden_dim = hidden_dim\par
        self.n_classes  = n_classes\par
        self.substrate  = ImageSubstrate(hidden_dim, tile, img_w, img_h)\par
        self.tower      = SharedUpperTower(hidden_dim, n_classes)\par
        self.ledger     = BlockchainLedger(ledger_path)\par
        self._epoch = 0; self._step = 0\par
\par
    def forward(self, rgb_tile, depth=0.0, conf=0.0):\par
        s,_,_ = self.substrate.forward(rgb_tile, depth, conf)\par
        l,_,_ = self.tower.forward(s)\par
        return _softmax(l)\par
\par
    def train_step(self, rgb_tile, target_class, lr=0.005,\par
                   tx=0, ty=0, depth=0.0, conf=0.0):\par
        s, Ls, Js = self.substrate.forward(rgb_tile, depth, conf)\par
        l, Lt, Jt = self.tower.forward(s)\par
        probs     = _softmax(l)\par
        loss      = _cross_entropy(probs, target_class)\par
        noether   = (Js + Jt) / 2.0\par
\par
        grad  = [p-(1.0 if i==target_class else 0.0)\par
                 for i,p in enumerate(probs)]\par
        gs, m = self.tower.backward(grad, lr, s)\par
        self.substrate.backward(rgb_tile, gs[:self.hidden_dim],\par
                                lr, depth, conf)\par
\par
        idx = self.substrate.hyperindex(rgb_tile, tx, ty, depth, conf)\par
        self.ledger.append('image', self._epoch, self._step,\par
                           idx.get('k_C','0'),\par
                           self.substrate.tile**2,\par
                           LNAME[0], noether, any(m.values()),\par
                           \{'color':idx.get('color_index','0'),\par
                            'r':idx.get('radial_r',0.0),\par
                            'loss':loss\})\par
        self._step += 1\par
        return loss, noether\par
