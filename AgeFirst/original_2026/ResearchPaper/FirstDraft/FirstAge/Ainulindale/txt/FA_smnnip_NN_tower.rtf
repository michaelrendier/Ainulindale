# DEMO\par
# ==============================================================================\par
\par
def run_demo():\par
    print("FA_smnnip_NN_tower -- Pure Python3 -- First Age")\par
    print("=" * 60)\par
    print(f"Lagrangian: (2/pi)*oint[L_kin + L_mat + (1/phi)*L_bias + L_coup]")\par
    print(f"phi = \{PHI:.6f\}   1/phi = \{BIAS_COUP:.6f\}")\par
    print(f"Radial: r(layer=0)=\{layer_to_r(0):.2f\}  r(layer=3)=\{layer_to_r(3):.2f\}")\par
    print()\par
\par
    # Text tower\par
    print("-- Text Tower --")\par
    txt = FATextNNTower(hidden_dim=32, ctx_len=4,\par
                         ledger_path='/tmp/FA_demo_ledger')\par
    corpus = (\par
        "the algebra tower is primary. the world is secondary. "\par
        "noether conservation holds at every boundary. "\par
        "permutations are the discrete skeleton of rotations. "\par
        "the two towers sing different themes into one music. "\par
    ) * 3\par
    for ep in range(3):\par
        loss, noether = txt.train_epoch(corpus, lr=0.005, max_steps=80)\par
        print(f"  Epoch \{ep+1\}: loss=\{loss:.4f\}  noether=\{noether:.4f\}")\par
    print(f"  Generated: \{repr(txt.generate('the ', length=30))\}")\par
    print(f"  \{txt.status()\}")\par
    print()\par
\par
    # Image tower\par
    print("-- Image Tower --")\par
    img = FAImageNNTower(hidden_dim=32, n_classes=8,\par
                          ledger_path='/tmp/FA_demo_ledger')\par
    tile = [[(x/7, y/7, 0.5) for y in range(8)] for x in range(8)]\par
    loss, noether = img.train_step(tile, target_class=3, tx=2, ty=2)\par
    th, ph, sa, ro = SphericalColor.rgb_to_spherical(0.5, 0.5, 0.5)\par
    print(f"  Tile step: loss=\{loss:.4f\}  noether=\{noether:.4f\}")\par
    print(f"  Center pixel: theta=\{th:.3f\} phi=\{ph:.3f\} "\par
          f"sat=\{sa:.3f\} lum=\{ro:.3f\}")\par
    print()\par
\par
    # Combined\par
    print("-- Combined Tower (Two Themes -> One Music) --")\par
    comb = FACombinedNNTower(hidden_dim=32, ctx_len=4,\par
                              ledger_path='/tmp/FA_demo_ledger')\par
    print(f"  \{comb.mastery_summary()\}")\par
    print()\par
\par
    # Blockchain\par
    print("-- Blockchain Verify --")\par
    led = BlockchainLedger('/tmp/FA_demo_ledger')\par
    v, _, msg = led.verify()\par
    print(f"  \{msg\}")\par
    print()\par
\par
    # Hyperindex\par
    print("-- Hyperindex --")\par
    seq = "the "\par
    ti, fi, dl = TextHyperIndex.index_record(seq)\par
    rec = TextHyperIndex.decode_text(ti, dl)\par
    print(f"  '\{seq\}' -> text_idx=\{ti\} (\{ti.bit_length()\} bits) "\par
          f"fano=\{fi\} -> '\{rec\}'")\par
    k  = MultiChannelTupper.encode_tile(\par
         [[[0.25*c for _ in range(8)] for _ in range(8)]\par
          for c in range(4)])\par
    print(f"  Tupper k_C=\{str(k[0])[:18]\}... (\{k[0].bit_length()\} bits)")\par
    print()\par
\par
    print("=" * 60)\par
    print("Done. Ledger: /tmp/FA_demo_ledger.jsonl + .chain")\par
\par
\par
if __name__ == '__main__':\par
    run_demo()\par

}