# SHARED UPPER TOWER (C -> H -> O)\par
# ==============================================================================\par
\par
class SharedUpperTower:\par
    """\par
    Shared C->H->O tower. Receives from either substrate.\par
    By layer C the modality is forgotten -- one Music.\par
    Sedenion boundary enforced at O (index 3).\par
    """\par
\par
    def __init__(self, hidden_dim, output_dim):\par
        self.hidden_dim = hidden_dim\par
        self.output_dim = output_dim\par
\par
        assert_within_tower(1)\par
        assert_within_tower(2)\par
        assert_within_tower(3)\par
\par
        self.W1 = MasteredWeightField(hidden_dim, hidden_dim, 1)\par
        self.B1 = MasteredBiasField(hidden_dim, 1, LMU[1], LLAM[1])\par
        self.W2 = MasteredWeightField(hidden_dim, hidden_dim, 2)\par
        self.B2 = MasteredBiasField(hidden_dim, 2, LMU[2], LLAM[2])\par
        self.W3 = MasteredWeightField(hidden_dim, output_dim, 3)\par
        self.B3 = MasteredBiasField(output_dim, 3, LMU[3], LLAM[3])\par
\par
        self.noether_hist:    List[float] = []\par
        self.lagrangian_hist: List[float] = []\par
\par
    def _fwd(self, psi, W, B, layer):\par
        assert_within_tower(layer)\par
        out   = W.forward(psi)\par
        out   = B.apply(out)\par
        out   = _relu(out)\par
        L_kin = -0.25 * W.field_strength()**2\par
        L_mat = _dot(psi, psi) * 0.1\par
        L_b   = B.polar_l_bias()\par
        L_c   = -W.g * _dot(psi, psi)\par
        L_p   = polar_lagrangian(L_kin, L_mat, L_b, L_c,\par
                                  layer=layer, L_total=L_TOTAL)\par
        J     = W.noether(psi)\par
        return out, L_p, J\par
\par
    def forward(self, sub_out):\par
        p, L1, J1 = self._fwd(sub_out, self.W1, self.B1, 1)\par
        p, L2, J2 = self._fwd(p, self.W2, self.B2, 2)\par
        p, L3, J3 = self._fwd(p, self.W3, self.B3, 3)\par
        L_tot = L1 + L2 + L3\par
        viol  = (abs(J2-J1) + abs(J3-J2)) / 2.0\par
        self.noether_hist.append(viol)\par
        self.lagrangian_hist.append(L_tot)\par
        return p, L_tot, viol\par
\par
    def backward(self, grad, lr, sub_out):\par
        hd = self.hidden_dim\par
        g3 = self.W3.update(sub_out[:hd], grad, lr)\par
        self.B3.update(grad, lr)\par
        g2 = self.W2.update(sub_out[:hd], g3[:hd], lr)\par
        self.B2.update(g3[:hd], lr)\par
        g1 = self.W1.update(sub_out[:hd], g2[:hd], lr)\par
        self.B1.update(g2[:hd], lr)\par
        mastery = \{\par
            'W1': self.W1.check_mastery(self.B1.vev),\par
            'B1': self.B1.check_mastery(),\par
            'W2': self.W2.check_mastery(self.B2.vev),\par
            'B2': self.B2.check_mastery(),\par
            'W3': self.W3.check_mastery(self.B3.vev),\par
            'B3': self.B3.check_mastery(),\par
        \}\par
        return g1, mastery\par
\par
    def mastered(self):\par
        return sum(1 for f in\par
                   [self.W1,self.B1,self.W2,self.B2,self.W3,self.B3]\par
                   if f.is_mastered())\par
\par
