# COMBINED TOWER (BOTH SUBSTRATES -> ONE SHARED TOWER)\par
# ==============================================================================\par
\par
class FACombinedNNTower:\par
    """\par
    The Two Towers -- one shared upper tower, two independent substrates.\par
\par
    TextSubstrate  --> |\par
                       +--> SharedUpperTower --> output\par
    ImageSubstrate --> |\par
\par
    Independent themes. One Music.\par
    """\par
\par
    def __init__(self, hidden_dim=64, ctx_len=8, n_classes=16,\par
                 ledger_path='FA_hyperindex_ledger'):\par
        out_dim = max(VOCAB_SIZE, n_classes)\par
        self.text_sub  = TextSubstrate(hidden_dim, ctx_len)\par
        self.img_sub   = ImageSubstrate(hidden_dim)\par
        self.tower     = SharedUpperTower(hidden_dim, out_dim)\par
        self.ledger    = BlockchainLedger(ledger_path)\par
        self._c2i      = \{c:i for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
        self._i2c      = \{i:c for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
\par
    def forward_text(self, ctx):\par
        s,_,_ = self.text_sub.forward(ctx)\par
        l,_,_ = self.tower.forward(s)\par
        return _softmax(l[:VOCAB_SIZE])\par
\par
    def forward_image(self, rgb_tile, depth=0.0, conf=0.0):\par
        s,_,_ = self.img_sub.forward(rgb_tile, depth, conf)\par
        l,_,_ = self.tower.forward(s)\par
        return _softmax(l)\par
\par
    def mastery_summary(self):\par
        v,_,msg = self.ledger.verify()\par
        return \{\par
            'tower_mastered': self.tower.mastered(),\par
            'text_W': self.text_sub.W.is_mastered(),\par
            'text_B': self.text_sub.B.is_mastered(),\par
            'img_W':  self.img_sub.W.is_mastered(),\par
            'img_B':  self.img_sub.B.is_mastered(),\par
            'chain':  v,\par
            'blocks': self.ledger._block_id,\par
        \}\par
\par
\par
