# ── Minimal math helpers ─────────────────────────────────────────────────────\par
\par
def _dot(a, b):   return sum(x*y for x,y in zip(a,b))\par
def _norm(v):     return math.sqrt(sum(x*x for x in v))\par
def _clip(x, lo=-10.0, hi=10.0): return max(lo, min(hi, x))\par
def _zeros(n):    return [0.0]*n\par
def _matvec(M, v): return [_dot(row, v) for row in M]\par
def _relu(v):     return [max(0.0, x) for x in v]\par
\par
def _softmax(v):\par
    m = max(v)\par
    e = [math.exp(x - m) for x in v]\par
    s = sum(e) + 1e-12\par
    return [x/s for x in e]\par
\par
def _cross_entropy(probs, idx):\par
    return -math.log(max(probs[idx], 1e-12))\par
\par
# ── Constants ────────────────────────────────────────────────────────────────\par
\par
L_TOTAL      = 4\par
PHI          = (1.0 + math.sqrt(5.0)) / 2.0\par
BIAS_COUP    = 1.0 / PHI        # 0.6180... (1/phi, Ainulindale corrected)\par
TWO_OVER_PI  = 2.0 / math.pi   # 0.6366...\par
\par
LNAME  = \{0:'R', 1:'C', 2:'H', 3:'O'\}\par
LGAUGE = \{0:'trivial', 1:'U(1)', 2:'SU(2)', 3:'G2/SU(3)'\}\par
LHBAR  = \{0:0.10, 1:0.08, 2:0.05, 3:0.02\}\par
LG     = \{0:0.010, 1:0.009, 2:0.007, 3:0.005\}\par
LMU    = \{0:0.5,  1:0.5,  2:0.4,  3:0.3\}\par
LLAM   = \{0:0.10, 1:0.10, 2:0.12, 3:0.15\}\par
