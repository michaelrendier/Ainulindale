# MASTERED WEIGHT FIELD\par
# ==============================================================================\par
\par
class MasteredWeightField:\par
    """Yang-Mills weight field with mastery crystallization."""\par
\par
    def __init__(self, in_d, out_d, layer):\par
        self.in_d  = in_d\par
        self.out_d = out_d\par
        self.layer = layer\par
        self.hbar  = LHBAR[layer]\par
        self.g     = LG[layer]\par
        self.r     = layer_to_r(layer, L_TOTAL)\par
        self.alpha = alpha_nn_from_r(self.g, self.hbar, self.r)\par
        self._mastered  = False\par
        self._threshold = MASTERY_THRESHOLDS[LNAME[layer]]\par
\par
        sc = math.sqrt(2.0 / (in_d + out_d))\par
        self.W  = [[random.gauss(0.0, sc) for _ in range(out_d)]\par
                   for _ in range(in_d)]\par
        self.dW = [[0.0]*out_d for _ in range(in_d)]\par
\par
    def is_mastered(self):   return self._mastered\par
    def forward(self, psi):\par
        return [sum(self.W[j][i]*psi[j] for j in range(min(self.in_d,len(psi))))\par
                for i in range(self.out_d)]\par
    def field_strength(self):\par
        return math.sqrt(sum(w**2 for row in self.W for w in row))\par
    def noether(self, psi):  return self.g * _dot(psi, psi)\par
\par
    def update(self, psi, grad, lr, mom=0.9):\par
        if self._mastered:\par
            gi = _zeros(self.in_d)\par
            for i in range(min(self.out_d, len(grad))):\par
                for j in range(self.in_d):\par
                    gi[j] += self.W[j][i] * grad[i]\par
            return gi\par
        gn = _norm(grad)\par
        sc = min(1.0, 1.0/(gn+1e-12)) if gn > 1.0 else 1.0\par
        gi = _zeros(self.in_d)\par
        for i in range(min(self.out_d, len(grad))):\par
            for j in range(min(self.in_d, len(psi))):\par
                dw = psi[j] * grad[i] * sc\par
                self.dW[j][i] = mom*self.dW[j][i] - lr*dw\par
                self.W[j][i]  = _clip(self.W[j][i] + self.dW[j][i])\par
                gi[j] += self.W[j][i] * grad[i]\par
        return gi\par
\par
    def check_mastery(self, vev):\par
        if self._mastered: return True\par
        if abs(self.field_strength() - vev) < self._threshold:\par
            self._mastered = True\par
            self.dW = [[0.0]*self.out_d for _ in range(self.in_d)]\par
        return self._mastered\par
\par
    def vev_dist(self, vev):\par
        return abs(self.field_strength() - vev)\par
\par
