# TEXT SUBSTRATE\par
# ==============================================================================\par
\par
class TextSubstrate:\par
    """Layer 0: US keyboard 97-char fixed vocab -> hidden_dim."""\par
\par
    def __init__(self, hidden_dim, ctx_len):\par
        self.vocab_size = VOCAB_SIZE\par
        self.hidden_dim = hidden_dim\par
        self.ctx_len    = ctx_len\par
        self.in_dim     = VOCAB_SIZE * ctx_len\par
        self.r          = layer_to_r(0, L_TOTAL)  # r=1.0\par
\par
        self._c2i = \{c: i for i, c in enumerate(US_KEYBOARD_CHARS)\}\par
        self._i2c = \{i: c for i, c in enumerate(US_KEYBOARD_CHARS)\}\par
\par
        self.W = MasteredWeightField(self.in_dim, hidden_dim, 0)\par
        self.B = MasteredBiasField(hidden_dim, 0, LMU[0], LLAM[0])\par
\par
    def one_hot(self, c):\par
        v = _zeros(self.vocab_size)\par
        if c in self._c2i: v[self._c2i[c]] = 1.0\par
        return v\par
\par
    def encode(self, ctx):\par
        flat = []\par
        for c in ctx[-self.ctx_len:]:\par
            flat.extend(self.one_hot(c))\par
        while len(flat) < self.in_dim: flat.append(0.0)\par
        return flat[:self.in_dim]\par
\par
    def forward(self, ctx):\par
        psi = self.encode(ctx)\par
        out = self.W.forward(psi)\par
        out = self.B.apply(out)\par
        out = _relu(out)\par
        L_kin  = -0.25 * self.W.field_strength()**2\par
        J      = self.W.noether(psi)\par
        return out, L_kin, J\par
\par
    def backward(self, ctx, grad, lr):\par
        psi = self.encode(ctx)\par
        gi  = self.W.update(psi, grad, lr)\par
        self.B.update(grad, lr)\par
        wm = self.W.check_mastery(self.B.vev)\par
        bm = self.B.check_mastery()\par
        return gi, wm, bm\par
\par
    def hyperindex(self, ctx):\par
        return TextHyperIndex.index_record(ctx)\par
\par
