# TEXT NN TOWER\par
# ==============================================================================\par
\par
class FATextNNTower:\par
    """TextSubstrate -> SharedUpperTower -> softmax."""\par
\par
    def __init__(self, hidden_dim=64, ctx_len=8,\par
                 ledger_path='FA_hyperindex_ledger'):\par
        self.ctx_len    = ctx_len\par
        self.hidden_dim = hidden_dim\par
        self.out_dim    = VOCAB_SIZE\par
        self.substrate  = TextSubstrate(hidden_dim, ctx_len)\par
        self.tower      = SharedUpperTower(hidden_dim, VOCAB_SIZE)\par
        self.ledger     = BlockchainLedger(ledger_path)\par
        self._c2i       = \{c:i for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
        self._i2c       = \{i:c for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
        self.loss_hist: List[float] = []\par
        self._epoch = 0; self._step = 0\par
\par
    def forward(self, ctx):\par
        s,_,_ = self.substrate.forward(ctx)\par
        l,_,_ = self.tower.forward(s)\par
        return _softmax(l)\par
\par
    def train_step(self, ctx, target, lr=0.005):\par
        s, Ls, Js = self.substrate.forward(ctx)\par
        l, Lt, Jt = self.tower.forward(s)\par
        probs     = _softmax(l)\par
        ti        = self._c2i.get(target, 0)\par
        loss      = _cross_entropy(probs, ti)\par
        noether   = (Js + Jt) / 2.0\par
\par
        grad  = [p-(1.0 if i==ti else 0.0) for i,p in enumerate(probs)]\par
        gs, m = self.tower.backward(grad, lr, s)\par
        self.substrate.backward(ctx, gs[:self.hidden_dim], lr)\par
\par
        ti_txt, fi, dl = self.substrate.hyperindex(ctx)\par
        self.ledger.append('text', self._epoch, self._step,\par
                           ti_txt, dl, LNAME[0], noether,\par
                           any(m.values()),\par
                           \{'fano':str(fi), 'loss':loss\})\par
        self.loss_hist.append(loss)\par
        self._step += 1\par
        return loss, noether\par
\par
    def train_epoch(self, text, lr=0.005, max_steps=500):\par
        valid  = [(i, text[i:i+self.ctx_len], text[i+self.ctx_len])\par
                  for i in range(len(text)-self.ctx_len-1)\par
                  if text[i+self.ctx_len] in self._c2i]\par
        random.shuffle(valid)\par
        valid = valid[:max_steps]\par
        tl = tn = 0.0\par
        for _, ctx, tgt in valid:\par
            ctx = ''.join(c if c in self._c2i else ' ' for c in ctx)\par
            l, n = self.train_step(ctx, tgt, lr)\par
            tl += l; tn += n\par
        self._epoch += 1\par
        n = max(1, len(valid))\par
        return tl/n, tn/n\par
\par
    def generate(self, seed, length=100, temp=1.0):\par
        ctx = seed[-self.ctx_len:]\par
        ctx = ''.join(c if c in self._c2i else ' ' for c in ctx)\par
        out = seed\par
        for _ in range(length):\par
            p = self.forward(ctx)\par
            if temp != 1.0:\par
                p = _softmax([math.log(x+1e-12)/temp for x in p])\par
            rv = random.random(); cu = 0.0; ch = 0\par
            for i, pv in enumerate(p):\par
                cu += pv\par
                if rv < cu: ch = i; break\par
            c  = self._i2c.get(ch, '?')\par
            out += c\par
            ctx = (ctx + c)[-self.ctx_len:]\par
        return out\par
\par
    def status(self):\par
        v,_,msg = self.ledger.verify()\par
        return (f"Mastery: tower \{self.tower.mastered()\}/6 "\par
                f"| steps=\{self._step\} | chain=\{msg[:30]\}")\par
\par
