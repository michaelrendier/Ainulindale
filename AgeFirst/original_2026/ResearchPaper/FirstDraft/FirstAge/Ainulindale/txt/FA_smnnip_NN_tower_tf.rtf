    class TFTextSubstrate(tf.keras.Model):\par
        """\par
        TF Layer 0: 97-char fixed vocab -> hidden_dim.\par
        Index arithmetic: pure Python (no TF int overflow).\par
        """\par
\par
        def __init__(self, hidden_dim, ctx_len):\par
            super().__init__(name='text_substrate')\par
            self.vocab_size = VOCAB_SIZE\par
            self.hidden_dim = hidden_dim\par
            self.ctx_len    = ctx_len\par
            self.in_dim     = VOCAB_SIZE * ctx_len\par
            self.r          = layer_to_r(0, L_TOTAL)  # r=1.0\par
\par
            # Python-side char maps (not TF)\par
            self._c2i = \{c: i for i, c in enumerate(US_KEYBOARD_CHARS)\}\par
            self._i2c = \{i: c for i, c in enumerate(US_KEYBOARD_CHARS)\}\par
\par
            self.W = TFMasteredLayer(self.in_dim, hidden_dim, 0, 'text')\par
            self.H = TFHiggsLayer(hidden_dim, 0, LMU[0], LLAM[0])\par
\par
        def one_hot_batch(self, contexts: List[str]) -> tf.Tensor:\par
            """\par
            Pure Python encodes context strings to one-hot tensors.\par
            Index arithmetic (char -> int) stays in Python.\par
            """\par
            batch = []\par
            for ctx in contexts:\par
                flat = []\par
                for c in ctx[-self.ctx_len:]:\par
                    v = [0.0] * self.vocab_size\par
                    if c in self._c2i:\par
                        v[self._c2i[c]] = 1.0\par
                    flat.extend(v)\par
                while len(flat) < self.in_dim:\par
                    flat.append(0.0)\par
                batch.append(flat[:self.in_dim])\par
            return tf.constant(batch, dtype=tf.float32)\par
\par
        def call(self, psi_input):\par
            out = self.W(psi_input)\par
            out = self.H(out)\par
            return out\par
\par
        def hyperindex(self, ctx: str):\par
            """Pure Python index -- no TF involved."""\par
            return TextHyperIndex.index_record(ctx)\par
\par
\par
