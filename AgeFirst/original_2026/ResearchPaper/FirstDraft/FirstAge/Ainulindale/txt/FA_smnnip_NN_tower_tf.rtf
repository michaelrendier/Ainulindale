    # =========================================================================\par
    # TF LAYER WITH MASTERY\par
    # =========================================================================\par
\par
    class TFMasteredLayer(tf.keras.layers.Layer):\par
        """\par
        Yang-Mills weight layer with mastery crystallization.\par
\par
        When mastered:\par
          - trainable=False set on all weights\par
          - forward pass still runs (zero cost: no gradient computation)\par
          - mastery flag stored as non-trainable tf.Variable\par
\par
        Index arithmetic (permutation, Tupper, Fano): pure Python.\par
        TF never sees the indices. They go straight to the ledger.\par
        """\par
\par
        def __init__(self, in_d, out_d, layer_idx, name_sfx='', **kw):\par
            super().__init__(name=f"mastered_L\{layer_idx\}_\{name_sfx\}", **kw)\par
            self.in_d       = in_d\par
            self.out_d      = out_d\par
            self.layer_idx  = layer_idx\par
            self.hbar       = LHBAR[layer_idx]\par
            self.g_coup     = LG[layer_idx]\par
            self.r          = layer_to_r(layer_idx, L_TOTAL)\par
            self.alpha_nn   = alpha_nn_from_r(self.g_coup, self.hbar, self.r)\par
            self._threshold = MASTERY_THRESHOLDS[LNAME[layer_idx]]\par
            self._mastered_flag = False\par
\par
            assert_within_tower(layer_idx)\par
\par
            scale = math.sqrt(2.0 / (in_d + out_d))\par
            self.W = self.add_weight(\par
                name='W', shape=(in_d, out_d),\par
                initializer=tf.initializers.TruncatedNormal(stddev=scale),\par
                trainable=True\par
            )\par
            self.b = self.add_weight(\par
                name='b', shape=(out_d,),\par
                initializer='zeros', trainable=True\par
            )\par
            # Non-trainable mastery flag (survives save/load)\par
            self.mastered = self.add_weight(\par
                name='mastered', shape=(), dtype=tf.bool,\par
                initializer=tf.initializers.Constant(False),\par
                trainable=False\par
            )\par
            # VEV reference\par
            self.vev_ref = self.add_weight(\par
                name='vev_ref', shape=(), dtype=tf.float32,\par
                initializer='zeros', trainable=False\par
            )\par
\par
        def call(self, psi):\par
            out = tf.matmul(psi, self.W) + self.b\par
            return tf.nn.relu(out)\par
\par
        def field_strength(self):\par
            return float(tf.norm(self.W).numpy())\par
\par
        def noether_current(self, psi):\par
            return float(self.g_coup * tf.reduce_sum(psi * psi).numpy())\par
\par
        def l_kinetic(self):\par
            return -0.25 * self.field_strength()**2\par
\par
        def vev_distance(self, vev):\par
            return abs(self.field_strength() - vev)\par
\par
        def check_mastery(self, vev):\par
            if self._mastered_flag:\par
                return True\par
            if self.vev_distance(vev) < self._threshold:\par
                self._mastered_flag = True\par
                self.mastered.assign(True)\par
                self.vev_ref.assign(float(vev))\par
                # Freeze weights\par
                self.W.assign(self.W)  # no-op for value; trainable cleared below\par
                # TF: set non-trainable by rebuilding trainable list\par
                self._set_mastered()\par
            return self._mastered_flag\par
\par
        def _set_mastered(self):\par
            """Freeze this layer's weights."""\par
            self.W._trainable = False\par
            self.b._trainable = False\par
\par
        def is_mastered(self):\par
            return self._mastered_flag\par
\par
\par
    class TFHiggsLayer(tf.keras.layers.Layer):\par
        """Higgs bias field with (1/phi) polar correction and mastery."""\par
\par
        def __init__(self, size, layer_idx, mu_sq, lam, **kw):\par
            super().__init__(name=f"higgs_L\{layer_idx\}", **kw)\par
            self.size     = size\par
            self.layer_idx = layer_idx\par
            self.mu_sq    = mu_sq\par
            self.lam      = lam\par
            self.vev      = math.sqrt(mu_sq/(2.0*lam)) if mu_sq > 0 else 0.0\par
            self._threshold = MASTERY_THRESHOLDS[LNAME[layer_idx]]\par
            self._mastered  = False\par
\par
            self.beta = self.add_weight(\par
                name='beta', shape=(size,),\par
                initializer=tf.initializers.TruncatedNormal(stddev=0.01),\par
                trainable=True\par
            )\par
\par
        def call(self, psi):\par
            return psi + self.beta\par
\par
        def potential(self):\par
            b2 = float(tf.reduce_sum(self.beta * self.beta).numpy())\par
            return -self.mu_sq*b2 + self.lam*b2*b2\par
\par
        def polar_l_bias(self):\par
            return BIAS_COUP * self.potential()\par
\par
        def vev_distance(self):\par
            b_norm = float(tf.norm(self.beta).numpy())\par
            return abs(b_norm - self.vev)\par
\par
        def check_mastery(self):\par
            if self._mastered: return True\par
            if self.vev_distance() < self._threshold:\par
                self._mastered = True\par
                self.beta._trainable = False\par
            return self._mastered\par
\par
        def is_mastered(self): return self._mastered\par
\par
