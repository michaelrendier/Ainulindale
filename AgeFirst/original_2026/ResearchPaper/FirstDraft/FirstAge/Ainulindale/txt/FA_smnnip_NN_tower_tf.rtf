    # =========================================================================\par
    # SHARED UPPER TOWER TF (C -> H -> O)\par
    # =========================================================================\par
\par
    class TFSharedUpperTower(tf.keras.Model):\par
        """\par
        TF C->H->O tower. Receives from either substrate.\par
        Sedenion boundary enforced.\par
        Polar Lagrangian computed using Python float ops on TF tensors\par
        (extracted via .numpy() -- outside the graph for logging only).\par
        """\par
\par
        def __init__(self, hidden_dim, output_dim):\par
            super().__init__(name='shared_upper_tower')\par
            assert_within_tower(1)\par
            assert_within_tower(2)\par
            assert_within_tower(3)\par
\par
            self.hidden_dim = hidden_dim\par
            self.output_dim = output_dim\par
\par
            self.W1 = TFMasteredLayer(hidden_dim, hidden_dim, 1, 'C')\par
            self.H1 = TFHiggsLayer(hidden_dim, 1, LMU[1], LLAM[1])\par
            self.W2 = TFMasteredLayer(hidden_dim, hidden_dim, 2, 'H')\par
            self.H2 = TFHiggsLayer(hidden_dim, 2, LMU[2], LLAM[2])\par
            self.W3 = TFMasteredLayer(hidden_dim, output_dim, 3, 'O')\par
            self.H3 = TFHiggsLayer(output_dim, 3, LMU[3], LLAM[3])\par
\par
            self.noether_hist:    List[float] = []\par
            self.lagrangian_hist: List[float] = []\par
\par
        def call(self, sub_out, training=False):\par
            p1 = self.W1(sub_out);  p1 = self.H1(p1)\par
            p2 = self.W2(p1);       p2 = self.H2(p2)\par
            p3 = self.W3(p2);       p3 = self.H3(p3)\par
            return p3\par
\par
        def polar_lagrangian_diagnostics(self, sub_out_np,\par
                                          layer=1) -> float:\par
            """\par
            Compute polar Lagrangian scalar for diagnostics.\par
            Uses Python floats (outside graph). Not used in gradient computation.\par
            """\par
            if hasattr(sub_out_np, 'numpy'):\par
                psi = sub_out_np.numpy().flatten().tolist()\par
            else:\par
                psi = list(sub_out_np)\par
            L_kin  = -0.25 * self.W1.field_strength()**2\par
            L_mat  = sum(x*x for x in psi[:8]) * 0.1\par
            L_bias = self.H1.polar_l_bias()\par
            L_coup = -self.W1.g_coup * sum(x*x for x in psi[:8])\par
            return polar_lagrangian(L_kin, L_mat, L_bias, L_coup,\par
                                    layer=layer, L_total=L_TOTAL)\par
\par
        def noether_violation(self, sub_out) -> float:\par
            """Noether current conservation diagnostic (Python float)."""\par
            if hasattr(sub_out, 'numpy'):\par
                psi = sub_out.numpy().flatten().tolist()\par
            else:\par
                psi = list(sub_out)\par
            J1 = self.W1.g_coup * sum(x*x for x in psi)\par
            J2 = self.W2.g_coup * sum(x*x for x in psi)\par
            J3 = self.W3.g_coup * sum(x*x for x in psi)\par
            return (abs(J2-J1) + abs(J3-J2)) / 2.0\par
\par
        def check_all_mastery(self, vev=0.5) -> Dict[str, bool]:\par
            return \{\par
                'W1': self.W1.check_mastery(vev),\par
                'H1': self.H1.check_mastery(),\par
                'W2': self.W2.check_mastery(vev),\par
                'H2': self.H2.check_mastery(),\par
                'W3': self.W3.check_mastery(vev),\par
                'H3': self.H3.check_mastery(),\par
            \}\par
\par
        def mastered_count(self):\par
            return sum(1 for f in\par
                       [self.W1,self.H1,self.W2,self.H2,self.W3,self.H3]\par
                       if f.is_mastered())\par
\par
