    # =========================================================================\par
    # TF TEXT NN TOWER\par
    # =========================================================================\par
\par
    class TFTextNNTower:\par
        """\par
        TF text tower: TextSubstrate -> SharedUpperTower -> softmax.\par
        Pure Python computes all permutation indices.\par
        TF handles all weight gradients via GradientTape.\par
        """\par
\par
        def __init__(self, hidden_dim=64, ctx_len=8,\par
                     ledger_path='FA_hyperindex_ledger'):\par
            self.ctx_len    = ctx_len\par
            self.hidden_dim = hidden_dim\par
            self.out_dim    = VOCAB_SIZE\par
\par
            self.substrate = TFTextSubstrate(hidden_dim, ctx_len)\par
            self.tower     = TFSharedUpperTower(hidden_dim, VOCAB_SIZE)\par
            self.opt       = tf.keras.optimizers.Adam(learning_rate=0.005)\par
            self.ledger    = BlockchainLedger(ledger_path)\par
\par
            self._c2i = \{c:i for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
            self._i2c = \{i:c for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
            self.loss_hist: List[float] = []\par
            self._epoch = 0; self._step = 0\par
\par
            # Build models by calling with dummy input\par
            dummy = self.substrate.one_hot_batch([' ' * ctx_len])\par
            sub_out = self.substrate(dummy, training=False)\par
            self.tower(sub_out, training=False)\par
\par
        @tf.function\par
        def _forward_tf(self, psi_input):\par
            sub_out = self.substrate(psi_input, training=True)\par
            logits  = self.tower(sub_out, training=True)\par
            return logits, sub_out\par
\par
        def train_step(self, context: str, target: str, lr: float = 0.005):\par
            """\par
            One training step.\par
            Index arithmetic: pure Python.\par
            Weight updates: TF GradientTape.\par
            """\par
            if target not in self._c2i:\par
                return None, None\par
            ti = self._c2i[target]\par
\par
            psi_input = self.substrate.one_hot_batch([context])\par
            target_t  = tf.constant([ti], dtype=tf.int32)\par
\par
            all_vars = (self.substrate.trainable_variables +\par
                        self.tower.trainable_variables)\par
\par
            with tf.GradientTape() as tape:\par
                sub_out = self.substrate(psi_input, training=True)\par
                logits  = self.tower(sub_out, training=True)\par
                probs   = tf.nn.softmax(logits)\par
                loss    = tf.reduce_mean(\par
                    tf.nn.sparse_softmax_cross_entropy_with_logits(\par
                        labels=target_t, logits=logits\par
                    )\par
                )\par
\par
            grads = tape.gradient(loss, all_vars)\par
            self.opt.apply_gradients(zip(grads, all_vars))\par
\par
            loss_val   = float(loss.numpy())\par
            noether    = self.tower.noether_violation(sub_out[0])\par
\par
            # Pure Python index (no TF arithmetic, no overflow)\par
            text_idx, fano_idx, data_len = self.substrate.hyperindex(context)\par
\par
            mastery = self.tower.check_all_mastery(vev=0.5)\par
            any_m   = any(mastery.values())\par
\par
            self.ledger.append(\par
                'text', self._epoch, self._step,\par
                text_idx, data_len, LNAME[0], noether, any_m,\par
                \{'fano': str(fano_idx), 'loss': loss_val\}\par
            )\par
            self.loss_hist.append(loss_val)\par
            self._step += 1\par
            return loss_val, noether\par
\par
        def train_epoch(self, text: str, lr: float = 0.005,\par
                        max_steps: int = 500):\par
            valid = [(text[i:i+self.ctx_len], text[i+self.ctx_len])\par
                     for i in range(len(text)-self.ctx_len-1)\par
                     if text[i+self.ctx_len] in self._c2i]\par
            random.shuffle(valid)\par
            valid = valid[:max_steps]\par
            tl = tn = 0.0; n = 0\par
            for ctx, tgt in valid:\par
                ctx = ''.join(c if c in self._c2i else ' ' for c in ctx)\par
                l, no = self.train_step(ctx, tgt, lr)\par
                if l is not None:\par
                    tl += l; tn += no; n += 1\par
            self._epoch += 1\par
            n = max(1, n)\par
            return tl/n, tn/n\par
\par
        def generate(self, seed: str, length: int = 100,\par
                     temp: float = 1.0) -> str:\par
            ctx = seed[-self.ctx_len:]\par
            ctx = ''.join(c if c in self._c2i else ' ' for c in ctx)\par
            out = seed\par
            for _ in range(length):\par
                psi  = self.substrate.one_hot_batch([ctx])\par
                so   = self.substrate(psi, training=False)\par
                log  = self.tower(so, training=False)\par
                if temp != 1.0:\par
                    log = log / temp\par
                probs = tf.nn.softmax(log)[0].numpy()\par
                ch = int(tf.random.categorical(\par
                    tf.math.log(tf.maximum(probs, 1e-12))[None], 1)[0,0])\par
                c  = self._i2c.get(ch, '?')\par
                out += c\par
                ctx = (ctx + c)[-self.ctx_len:]\par
            return out\par
\par
        def status(self):\par
            v,_,msg = self.ledger.verify()\par
            return (f"TF Mastery: tower \{self.tower.mastered_count()\}/6 "\par
                    f"| steps=\{self._step\} | \{msg[:30]\}")\par
\par
\par
    # =========================================================================\par
    # TF IMAGE NN TOWER\par
    # =========================================================================\par
\par
    class TFImageNNTower:\par
        """TF image tower: ImageSubstrate -> SharedUpperTower -> class output."""\par
\par
        def __init__(self, hidden_dim=64, n_classes=16, tile=8,\par
                     img_w=8, img_h=8,\par
                     ledger_path='FA_hyperindex_ledger'):\par
            self.hidden_dim = hidden_dim\par
            self.n_classes  = n_classes\par
\par
            self.substrate = TFImageSubstrate(hidden_dim, tile, img_w, img_h)\par
            self.tower     = TFSharedUpperTower(hidden_dim, n_classes)\par
            self.opt       = tf.keras.optimizers.Adam(learning_rate=0.005)\par
            self.ledger    = BlockchainLedger(ledger_path)\par
            self._epoch = 0; self._step = 0\par
\par
            # Build\par
            dummy_tile = [[(0.5,0.5,0.5) for _ in range(tile)]\par
                          for _ in range(tile)]\par
            dummy_t = self.substrate.encode_batch([dummy_tile])\par
            so = self.substrate(dummy_t, training=False)\par
            self.tower(so, training=False)\par
\par
        def train_step(self, rgb_tile, target_class: int, lr=0.005,\par
                       tx=0, ty=0, depth=0.0, conf=0.0):\par
            psi_input = self.substrate.encode_batch([rgb_tile],[depth],[conf])\par
            target_t  = tf.constant([target_class], dtype=tf.int32)\par
\par
            all_vars = (self.substrate.trainable_variables +\par
                        self.tower.trainable_variables)\par
\par
            with tf.GradientTape() as tape:\par
                sub_out = self.substrate(psi_input, training=True)\par
                logits  = self.tower(sub_out, training=True)\par
                loss    = tf.reduce_mean(\par
                    tf.nn.sparse_softmax_cross_entropy_with_logits(\par
                        labels=target_t, logits=logits\par
                    )\par
                )\par
\par
            grads = tape.gradient(loss, all_vars)\par
            self.opt.apply_gradients(zip(grads, all_vars))\par
\par
            loss_val = float(loss.numpy())\par
            noether  = self.tower.noether_violation(sub_out[0])\par
\par
            # Pure Python Tupper index\par
            idx = self.substrate.hyperindex(rgb_tile, tx, ty, depth, conf)\par
            tile_idx = idx.get('k_C', '0')\par
\par
            mastery = self.tower.check_all_mastery()\par
            self.ledger.append(\par
                'image', self._epoch, self._step,\par
                tile_idx, self.substrate.tile**2,\par
                LNAME[0], noether, any(mastery.values()),\par
                \{'color': idx.get('color_index','0'),\par
                 'r': idx.get('radial_r', 0.0),\par
                 'loss': loss_val\}\par
            )\par
            self._step += 1\par
            return loss_val, noether\par
\par
\par
    # =========================================================================\par
    # TF COMBINED TOWER\par
    # =========================================================================\par
\par
    class TFCombinedNNTower:\par
        """\par
        The Two Towers (TF) -- one shared upper tower, two substrates.\par
        Independent themes. One Music.\par
        """\par
\par
        def __init__(self, hidden_dim=64, ctx_len=8, n_classes=16,\par
                     ledger_path='FA_hyperindex_ledger'):\par
            out_dim = max(VOCAB_SIZE, n_classes)\par
            self.text_sub  = TFTextSubstrate(hidden_dim, ctx_len)\par
            self.img_sub   = TFImageSubstrate(hidden_dim)\par
            self.tower     = TFSharedUpperTower(hidden_dim, out_dim)\par
            self.ledger    = BlockchainLedger(ledger_path)\par
            self._c2i = \{c:i for i,c in enumerate(US_KEYBOARD_CHARS)\}\par
            self._epoch = 0; self._step = 0\par
\par
            # Build\par
            dummy_ctx = self.text_sub.one_hot_batch([' ' * ctx_len])\par
            so = self.text_sub(dummy_ctx, training=False)\par
            self.tower(so, training=False)\par
\par
        def forward_text(self, ctx: str) -> List[float]:\par
            psi = self.text_sub.one_hot_batch([ctx])\par
            so  = self.text_sub(psi, training=False)\par
            l   = self.tower(so, training=False)\par
            return tf.nn.softmax(l[0,:VOCAB_SIZE]).numpy().tolist()\par
\par
        def forward_image(self, rgb_tile, depth=0.0, conf=0.0):\par
            psi = self.img_sub.encode_batch([rgb_tile],[depth],[conf])\par
            so  = self.img_sub(psi, training=False)\par
            l   = self.tower(so, training=False)\par
            return tf.nn.softmax(l[0]).numpy().tolist()\par
\par
        def mastery_summary(self):\par
            v,_,msg = self.ledger.verify()\par
            return \{\par
                'tower_mastered': self.tower.mastered_count(),\par
                'text_W': self.text_sub.W.is_mastered(),\par
                'img_W':  self.img_sub.W.is_mastered(),\par
                'chain':  v,\par
                'blocks': self.ledger._block_id,\par
            \}\par
\par
