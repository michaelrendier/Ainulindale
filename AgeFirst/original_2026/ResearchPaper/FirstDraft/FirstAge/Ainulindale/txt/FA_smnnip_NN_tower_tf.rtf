\par
    class TFImageSubstrate(tf.keras.Model):\par
        """\par
        TF Layer 0: 8x8 RGB tile -> spherical CMYK Oct -> hidden_dim.\par
        Spherical color encoding: pure Python (SphericalColor).\par
        Tupper index: pure Python (MultiChannelTupper).\par
        TF only handles the Dense layer weights.\par
        """\par
\par
        def __init__(self, hidden_dim, tile=8, img_w=8, img_h=8):\par
            super().__init__(name='image_substrate')\par
            self.tile       = tile\par
            self.in_dim     = tile * tile * 8\par
            self.hidden_dim = hidden_dim\par
            self.img_w      = img_w\par
            self.img_h      = img_h\par
\par
            self.W = TFMasteredLayer(self.in_dim, hidden_dim, 0, 'image')\par
            self.H = TFHiggsLayer(hidden_dim, 0, LMU[0], LLAM[0])\par
\par
        def encode_batch(self, tiles, depths=None, confs=None):\par
            """\par
            Pure Python spherical CMYK encoding.\par
            Returns tf.Tensor for TF to process.\par
            """\par
            batch = []\par
            for bi, tile in enumerate(tiles):\par
                d = depths[bi] if depths else 0.0\par
                c = confs[bi]  if confs  else 0.0\par
                flat = []\par
                for x in range(self.tile):\par
                    for y in range(self.tile):\par
                        try:   rv,gv,bv = tile[x][y]\par
                        except: rv,gv,bv = 0.0,0.0,0.0\par
                        flat.extend(SphericalColor.to_octonion(rv,gv,bv,d,c))\par
                while len(flat) < self.in_dim: flat.append(0.0)\par
                batch.append(flat[:self.in_dim])\par
            return tf.constant(batch, dtype=tf.float32)\par
\par
        def call(self, psi_input):\par
            out = self.W(psi_input)\par
            out = self.H(out)\par
            return out\par
\par
        def hyperindex(self, rgb_tile, tx=0, ty=0, depth=0.0, conf=0.0):\par
            """Pure Python Tupper index -- no TF."""\par
            return ImageHyperIndex.index_record(\par
                rgb_tile, tx, ty, self.img_w, self.img_h, depth, conf)\par
\par
        def tile_r(self, tx, ty):\par
            return ImageHyperIndex.tile_radial_r(tx, ty, self.img_w, self.img_h)\par
\par
